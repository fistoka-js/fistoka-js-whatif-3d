      ],
      "camera": {
        "move": "rise",
        "angle": "low",
        "framing": "medium",
        "amount": 0.6
      },
      "actions": [
        {
          "at": "rockets",
          "do": "set",
          "prop": "rocket",
          "param": "thrust",
          "to": 1,
          "over": 0.5
        },
        {
          "at": "launch",
          "do": "move",
          "prop": "rocket",
          "to": [
            0,
            1.6,
            0
          ],
          "over": 2.2,
          "ease": "in"
        },
        {
          "at": "far north",
          "do": "text",
          "text": "FAR NORTH",
          "style": "title",
          "pos": "top"
        }
      ]
    },
    {
      "id": "ring-rain",
      "start": "And here's",
      "transition": "dip",
      "env": {
        "type": "space",
        "nebula": "teal"
      },
      "props": [
        {
          "id": "saturn",
          "type": "planet",
          "look": "gas",
          "rings": true,
          "at": "center",
          "size": 1.5
        },
        {
          "id": "rain",
          "type": "arrow",
          "from": [
            1.2,
            1.0,
            0.3
          ],
          "to": "saturn",
          "color": "cyan",
          "length": 0
        }
      ],
      "camera": {
        "move": "orbit",
        "angle": "three-quarter",
        "amount": 0.4
      },
      "actions": [
        {
          "at": "strange part",
          "do": "icon",
          "prop": "saturn",
          "name": "question",
          "until": "Saturn's rings"
        },
        {
          "at": "raining down",
          "do": "set",
          "prop": "rain",
          "param": "length",
          "to": 1,
          "over": 0.8
        },
        {
          "at": "raining down",
          "do": "label",
          "prop": "saturn",
          "text": "RING RAIN",
          "side": "left"
        }
      ]
    },
    {
      "id": "gone",
      "start": "Scientists think",
      "env": {
        "type": "space",
        "nebula": "purple",
        "stars": 1.5
      },
      "props": [
        {
          "id": "saturn",
          "type": "planet",
          "look": "gas",
          "at": "center",
          "size": 1.3
        },
        {
          "id": "band",
          "type": "ring",
          "style": "flat",
          "tilt": 70,
          "thickness": 0.07,
          "color": "#e8d4a0",
          "at": "center",
          "size": 2.6
        }
      ],
      "camera": {
        "move": "pull_out",
        "angle": "front",
        "amount": 0.5
      },
      "actions": [
        {
          "at": "few hundred",
          "do": "count",
          "from": 0,
          "to": 300,
          "unit": "M YEARS",
          "pos": "top",
          "over": 1.4
        },
        {
          "at": "mostly gone",
          "do": "disappear",
          "prop": "band",
          "style": "shrink",
          "over": 1.6
        }
      ]
    },
    {
      "id": "enjoy",
      "start": "So enjoy",
      "env": {
        "type": "sky",
        "time": "sunset",
        "ground": "grass",
        "clouds": 0.3
      },
      "props": [
        {
          "id": "arch",
          "type": "ring",
          "style": "flat",
          "tilt": 10,
          "thickness": 0.08,
          "color": "#ffd9a0",
          "at": [
            0,
            -0.6,
            -2.5
          ],
          "size": 5
        },
        {
          "id": "sitter",
          "type": "person",
          "pose": "sit",
          "color": "teal",
          "at": [
            -0.3,
            0,
            0.9
          ],
          "size": 0.8
        }
      ],
      "camera": {
        "move": "rise",
        "angle": "low",
        "framing": "wide",
        "focus": [
          "sitter"
        ],
        "amount": 0.4
      },
      "actions": [
        {
          "at": "enjoy the view",
          "do": "bob",
          "prop": "sitter",
